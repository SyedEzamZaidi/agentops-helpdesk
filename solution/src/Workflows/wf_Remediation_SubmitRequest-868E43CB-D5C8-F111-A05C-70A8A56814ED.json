              "runAfter": {},
              "metadata": {
                "operationMetadataId": "ee686181-2bb4-464b-825b-c4f48ba27f62"
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Find_Latest_Decision": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "84f336d3-05b7-4abb-a390-ad98d9c1fce5"
          },
          "type": "Foreach"
        },
