                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "ezm_remediationrequests",
                      "item/ezm_AgentDecision@odata.bind": "ezm_agentdecisions(@{items('Apply_to_each_(For_Decision_ROw)')?['ezm_agentdecisionid']})",
