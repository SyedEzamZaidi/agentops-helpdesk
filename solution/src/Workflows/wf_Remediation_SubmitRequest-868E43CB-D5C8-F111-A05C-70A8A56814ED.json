              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "ezm_remediationcatalogs",
              "$filter": "ezm_actioncode eq @{variables('ActionCodeValue')}and ezm_active eq true",
