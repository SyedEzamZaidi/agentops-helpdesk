                      "item/ezm_requeststatus": 791760000,
                      "item/ezm_requesteremail": "@triggerBody()['text_2']",
                      "item/ezm_targetuseremail": "@triggerBody()['text_1']"
                    },
                    "authentication": "@parameters('$authentication')"
