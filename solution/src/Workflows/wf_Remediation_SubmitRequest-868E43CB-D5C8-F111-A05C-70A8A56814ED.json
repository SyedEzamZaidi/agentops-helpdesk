            },
            "parameters": {
              "entityName": "ezm_agentdecisions",
              "$filter": "ezm_conversationid eq '@{triggerBody()['text_3']}'",
              "$orderby": "createdon desc",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Apply_to_each_(For_Catalog)": {
          "foreach": "@outputs('Find_Catalog_Fix')?['body/value']",
          "actions": {
            "Apply_to_each_(For_Decision_ROw)": {
              "foreach": "@outputs('Find_Latest_Decision')?['body/value']",
