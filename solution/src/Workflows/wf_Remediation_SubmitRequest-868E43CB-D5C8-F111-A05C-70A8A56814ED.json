            "schema": {
              "type": "object",
              "properties": {
                "requestnumber": {
                  "title": "RequestNumber",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "templateName": null
