                },
                "Mark_Handled_By_Remediation": {
                  "runAfter": {
                    "Remember_Request_Number": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "01f71029-9128-4de9-9798-882c86252116"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "ezm_agentdecisions",
                      "recordId": "@items('Apply_to_each_(For_Decision_ROw)')?['ezm_agentdecisionid']",
                      "item/ezm_handledby": 791760003
